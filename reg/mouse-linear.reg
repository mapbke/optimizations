Windows Registry Editor Version 5.00

; Mouse EPP OFF and Windows pointer slider 6/11 (sensitivity value 10).
; Prefer the START.cmd Mouse profile: it makes an exact backup first.
; These keys affect Windows pointer handling; CS2 raw input bypasses Windows acceleration.
[HKEY_CURRENT_USER\Control Panel\Mouse]
"MouseSpeed"="0"
"MouseThreshold1"="0"
"MouseThreshold2"="0"
"MouseSensitivity"="10"
